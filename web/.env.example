# Copy to .env.local (or set these on the process) and restart the panel.
#
# None of these are strictly required: with no configuration the panel serves on
# port 3001, bootstraps an admin user named "admin" with password "admin", and
# expects the backup-mgr binary on PATH. That default password must be changed on
# first sign-in before anything else works.

# Initial admin password. Only used when the user database is created for the
# first time; changing it later has no effect (use the Users page instead).
# BACKUP_MGR_PASSWORD=change-me

# Secret used to sign session cookies. If unset, one is generated and stored in
# data/session.secret (mode 0600).
# BACKUP_MGR_SESSION_SECRET=random-long-string

# Optional overrides. Defaults assume this app lives in <repo>/web and the
# binary is on PATH — so they usually only need setting if you run the panel
# from somewhere unusual. Use YOUR OWN paths here, never paste them into the repo.
# BACKUP_MGR_ROOT=/srv/drive-backup
# BACKUP_MGR_CONFIG=/srv/drive-backup/config.yml
# BACKUP_MGR_BIN=/usr/local/bin/backup-mgr

# Where users.db and session.secret are stored (default: ./data).
# BACKUP_MGR_DATA_DIR=/srv/drive-backup/web/data

# pm2 app name shown on the Dashboard's Daemon card (default: backup-mgr).
# BACKUP_MGR_PM2_NAME=backup-mgr

# rclone config used when the panel creates remotes (defaults to rclone's own).
# RCLONE_CONFIG=/home/you/.config/rclone/rclone.conf
