# Copy to .env.local (or set these on the process) and restart the panel.
#
# None of these are required. With no configuration the panel listens on
# 0.0.0.0:3001, mirrors the server's Linux accounts as panel users, and expects
# the backup-mgr binary on PATH.
#
# There are NO panel passwords and no default account. You sign in with your
# Linux username and password, so the first panel user is simply an existing
# account on the box — there is nothing to bootstrap and nothing to change.
#
# Nearly all of the knobs below only exist so the panel can be pointed at a
# non-standard layout. The everyday workflow is:
#
#   sudo adduser alice    # alice appears in the panel within seconds
#
# ...then sign in as alice. The first admin is chosen as described below.

# ---------------------------------------------------------------------------
# Privileges: sudo is the source of truth
# ---------------------------------------------------------------------------
#
# An account that may run `sudo` on the server is a panel administrator, and root
# holds everything. The panel asks sudo itself (`sudo -l -U <user>`), so sudoers.d
# entries and per-command rules are seen. The panel never grants or revokes admin,
# which is why "who is an admin" is not an option below.
#
# Privileged work — managing users, reinstalling the shared binary, provisioning or
# acting on someone else's instance — runs under the *acting* user's own sudo. If
# that account's rules are NOPASSWD, nothing is ever asked. Otherwise one dialog
# asks for the sudo password (the same one sudo itself asks for), and after that it
# is not asked again until the timeout lapses.

# How long an elevated session lasts before the password is needed again.
# Default 900000 ms (15 minutes), which is sudo's own default.
# BACKUP_MGR_SUDO_TIMEOUT_MS=900000

# Groups treated as "has sudo" when sudo cannot be queried at all. Only a fallback.
# BACKUP_MGR_SUDO_GROUPS=sudo,admin,wheel

# Escape hatch for a host where the panel cannot ask sudo: always treat this one
# account as an administrator. Not a way to hand out admin — for that, use sudo.
# BACKUP_MGR_ADMIN_USER=youruser

# A canned capability answer instead of asking sudo, as JSON:
#   {"alice": {"has_sudo": true, "passwordless": false}, "bob": {"has_sudo": false}}
# Used by the tests; also handy when sudo cannot be probed.
# BACKUP_MGR_SUDO_FIXTURE=/srv/drive-backup/web/data/sudo.json

# ---------------------------------------------------------------------------
# Which accounts appear in the panel
# ---------------------------------------------------------------------------

# Lowest uid treated as a human account. Default 1000.
# BACKUP_MGR_MIN_UID=1000

# Include root as a panel user. Set to 0 to leave root out entirely.
# BACKUP_MGR_INCLUDE_ROOT=1

# Never mirror these accounts, comma-separated.
# BACKUP_MGR_EXCLUDE_USERS=olduser,ci

# How long a /etc/passwd read is cached. Default 5000 ms.
# BACKUP_MGR_OSUSER_CACHE_MS=5000

# ---------------------------------------------------------------------------
# Keeping the mirror current
# ---------------------------------------------------------------------------

# Reconcile the panel's user list with the server automatically. On by default;
# the panel reconciles at startup, on a timer, and whenever the passwd file
# changes — which is what makes `sudo adduser` the whole story.
# BACKUP_MGR_AUTO_SYNC=1

# Timer interval, in ms (minimum 2000). Default 15000.
# BACKUP_MGR_AUTO_SYNC_INTERVAL_MS=15000

# Also create a new account's instance for it: its own directory, a config.yml
# seeded from config.example.yml, and an ecosystem file. Off by default, because
# it writes into that user's home — turn it on if you want zero-touch onboarding.
# New accounts always work immediately either way; this only saves the admin the
# "Provision" click on the Users page.
# BACKUP_MGR_AUTO_PROVISION=1

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Secret used to sign session cookies. If unset, one is generated and stored in
# data/session.secret (mode 0600).
# BACKUP_MGR_SESSION_SECRET=random-long-string

# Where the panel's own state lives: users.db, session.secret, instances.yml
# (default: ./data, mode 0700).
# BACKUP_MGR_DATA_DIR=/srv/drive-backup/web/data

# The served checkout — Cargo.toml, target/ and config.example.yml live here.
# Instance paths are per-user and never come from this.
# BACKUP_MGR_CHECKOUT=/srv/drive-backup

# Where each user's instance lives. {home} is the account's home directory.
# Default: {home}/backup-mgr
# BACKUP_MGR_INSTANCE_TEMPLATE={home}/backup-mgr

# Template copied into a new instance's config.yml.
# Default: <checkout>/config.example.yml
# BACKUP_MGR_CONFIG_TEMPLATE=/srv/drive-backup/config.example.yml

# Keep a specific user's instance somewhere else (e.g. an existing deployment).
# This is the YAML file the panel reads; it is not an environment variable that
# contains the mapping.
# BACKUP_MGR_INSTANCES_FILE=/srv/drive-backup/web/data/instances.yml

# The shared backup-mgr binary that every instance runs.
# BACKUP_MGR_BIN=/usr/local/bin/backup-mgr

# pm2 binary. Each instance gets its own pm2 daemon via PM2_HOME, not its own install.
# PM2_BIN=/usr/bin/pm2

# Cargo used by the one-click "Rebuild & reinstall" button.
# CARGO_BIN=/home/you/.cargo/bin/cargo

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------

# Port and bind address for `next start` (the ecosystem file reads these).
# BACKUP_MGR_WEB_PORT=3001
# BACKUP_MGR_WEB_HOST=127.0.0.1   # expose the panel only through nginx

# rclone config the panel's commands use. Normally you do NOT set this: each
# instance gets RCLONE_CONFIG pointing at that user's own file.
# RCLONE_CONFIG=/home/you/.config/rclone/rclone.conf

# ---------------------------------------------------------------------------
# Advanced: alternate account database, and sign-in throttling
# ---------------------------------------------------------------------------
#
# These exist for tests and unusual hosts (NIS/LDAP, a curated account list).
# They are also the only reason BACKUP_MGR_PASSWD_FILE / BACKUP_MGR_SHADOW_FILE
# are documented: normally the panel reads the live getent database and
# /etc/shadow.

# BACKUP_MGR_PASSWD_FILE=/etc/passwd
# BACKUP_MGR_SHADOW_FILE=/etc/shadow

# Failed sign-ins before a lockout, and the minimum reply time (which hides
# whether a username exists). Defaults: 5 and 350 ms. Attempts at a sudo password
# are throttled too, in their own bucket, so guessing it cannot lock out sign-in.
# BACKUP_MGR_MAX_LOGIN_FAILURES=5
# BACKUP_MGR_MIN_VERIFY_MS=350
